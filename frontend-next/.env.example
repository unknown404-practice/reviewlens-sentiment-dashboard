# ReviewLens Next.js Frontend Configuration
# =========================================
# This variable is public because the browser requires the FastAPI backend URL.
# DO NOT put private credentials or secrets in NEXT_PUBLIC_ variables.

# Local Development (FastAPI default):
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Vercel Production Deployment:
# Set this in your Vercel Project Settings > Environment Variables:
# NEXT_PUBLIC_API_BASE_URL=https://your-fastapi-backend-domain.onrender.com
